<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget's declaration to the launcher. API 26 baseline.

    updatePeriodMillis is 0 on purpose. The platform clamps it to thirty minutes and
    ignores it entirely while the device dozes, so relying on it would mean a widget that
    is correct only sometimes and burns battery being wrong. Wird pushes an update when
    something actually changes instead - see refreshWidget().

    The grid-sizing attributes (targetCellWidth / targetCellHeight) are API 31+, so they
    live in res/xml-v31 rather than being declared here and ignored. minWidth/minHeight are
    what older launchers actually read.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/glance_default_loading_layout" />
