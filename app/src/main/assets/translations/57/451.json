[{"v":"37:127","t":"Fakaththaboohu fa-innahum lamuhdaroon"},{"v":"37:128","t":"Illa AAibada Allahialmukhlaseen"},{"v":"37:129","t":"Watarakna AAalayhi fee al-akhireen"},{"v":"37:130","t":"Salamun AAala il yaseen"},{"v":"37:131","t":"Inna kathalika najzee almuhsineen"},{"v":"37:132","t":"Innahu min AAibadinaalmu/mineen"},{"v":"37:133","t":"Wa-inna lootan lamina almursaleen"},{"v":"37:134","t":"Ith najjaynahu waahlahuajmaAAeen"},{"v":"37:135","t":"Illa AAajoozan fee alghabireen"},{"v":"37:136","t":"Thumma dammarna al-akhareen"},{"v":"37:137","t":"Wa-innakum latamurroona AAalayhim musbiheen"},{"v":"37:138","t":"Wabillayli afala taAAqiloon"},{"v":"37:139","t":"Wa-inna yoonusa lamina almursaleen"},{"v":"37:140","t":"Ith abaqa ila alfulki almashhoon"},{"v":"37:141","t":"Fasahama fakana mina almudhadeen"},{"v":"37:142","t":"Faltaqamahu alhootu wahuwamuleem"},{"v":"37:143","t":"Falawla annahu kana minaalmusabbiheen"},{"v":"37:144","t":"Lalabitha fee batnihi ilayawmi yubAAathoon"},{"v":"37:145","t":"Fanabathnahu bilAAara-iwahuwa saqeem"},{"v":"37:146","t":"Waanbatna AAalayhi shajaratan minyaqteen"},{"v":"37:147","t":"Waarsalnahu ila mi-ati alfinaw yazeedoon"},{"v":"37:148","t":"Faamanoo famattaAAnahum ilaheen"},{"v":"37:149","t":"Fastaftihim alirabbika albanatuwalahumu albanoon"},{"v":"37:150","t":"Am khalaqna almala-ikata inathanwahum shahidoon"},{"v":"37:151","t":"Ala innahum min ifkihim layaqooloon"},{"v":"37:152","t":"Walada Allahu wa-innahum lakathiboon"},{"v":"37:153","t":"Astafa albanati AAalaalbaneen"}]