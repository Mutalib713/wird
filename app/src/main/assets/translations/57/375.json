[{"v":"26:184","t":"Wattaqoo allathee khalaqakumwaljibillata al-awwaleen"},{"v":"26:185","t":"Qaloo innama anta mina almusahhareen"},{"v":"26:186","t":"Wama anta illa basharunmithluna wa-in nathunnuka lamina alkathibeen"},{"v":"26:187","t":"Faasqit AAalayna kisafan minaassama-i in kunta mina assadiqeen"},{"v":"26:188","t":"Qala rabbee aAAlamu bimataAAmaloon"},{"v":"26:189","t":"Fakaththaboohu faakhathahumAAathabu yawmi aththullati innahu kanaAAathaba yawmin AAatheem"},{"v":"26:190","t":"Inna fee thalika laayatan wamakana aktharuhum mu/mineen"},{"v":"26:191","t":"Wa-inna rabbaka lahuwa alAAazeezu arraheem"},{"v":"26:192","t":"Wa-innahu latanzeelu rabbi alAAalameen"},{"v":"26:193","t":"Nazala bihi arroohu al-ameen"},{"v":"26:194","t":"AAala qalbika litakoona mina almunthireen"},{"v":"26:195","t":"Bilisanin AAarabiyyin mubeen"},{"v":"26:196","t":"Wa-innahu lafee zuburi al-awwaleen"},{"v":"26:197","t":"Awa lam yakun lahum ayatan anyaAAlamahu AAulamao banee isra-eel"},{"v":"26:198","t":"Walaw nazzalnahu AAala baAAdial-aAAjameen"},{"v":"26:199","t":"Faqaraahu AAalayhim ma kanoobihi mu/mineen"},{"v":"26:200","t":"Kathalika salaknahu feequloobi almujrimeen"},{"v":"26:201","t":"La yu/minoona bihi hattayarawoo alAAathaba al-aleem"},{"v":"26:202","t":"Faya/tiyahum baghtatan wahum layashAAuroon"},{"v":"26:203","t":"Fayaqooloo hal nahnu muntharoon"},{"v":"26:204","t":"AfabiAAathabina yastaAAjiloon"},{"v":"26:205","t":"Afaraayta in mattaAAnahum sineen"},{"v":"26:206","t":"Thumma jaahum ma kanooyooAAadoon"}]