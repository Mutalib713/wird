[{"v":"26:112","t":"Qala wama AAilmee bimakanoo yaAAmaloon"},{"v":"26:113","t":"In hisabuhum illa AAalarabbee law tashAAuroon"},{"v":"26:114","t":"Wama ana bitaridialmu/mineen"},{"v":"26:115","t":"In ana illa natheerunmubeen"},{"v":"26:116","t":"Qaloo la-in lam tantahi yanoohu latakoonanna mina almarjoomeen"},{"v":"26:117","t":"Qala rabbi inna qawmee kaththaboon"},{"v":"26:118","t":"Faftah baynee wabaynahum fathanwanajjinee waman maAAiya mina almu/mineen"},{"v":"26:119","t":"Faanjaynahu waman maAAahu feealfulki almashhoon"},{"v":"26:120","t":"Thumma aghraqna baAAdu albaqeen"},{"v":"26:121","t":"Inna fee thalika laayatan wamakana aktharuhum mu/mineen"},{"v":"26:122","t":"Wa-inna rabbaka lahuwa alAAazeezu arraheem"},{"v":"26:123","t":"Kaththabat AAadun almursaleen"},{"v":"26:124","t":"Ith qala lahum akhoohumhoodun ala tattaqoon"},{"v":"26:125","t":"Innee lakum rasoolun ameen"},{"v":"26:126","t":"Fattaqoo Allaha waateeAAoon"},{"v":"26:127","t":"Wama as-alukum AAalayhi min ajrin inajriya illa AAala rabbi alAAalameen"},{"v":"26:128","t":"Atabnoona bikulli reeAAin ayatantaAAbathoon"},{"v":"26:129","t":"Watattakhithoona masaniAAalaAAallakum takhludoon"},{"v":"26:130","t":"Wa-itha batashtum batashtumjabbareen"},{"v":"26:131","t":"Fattaqoo Allaha waateeAAoon"},{"v":"26:132","t":"Wattaqoo allathee amaddakumbima taAAlamoon"},{"v":"26:133","t":"Amaddakum bi-anAAamin wabaneen"},{"v":"26:134","t":"Wajannatin waAAuyoon"},{"v":"26:135","t":"Innee akhafu AAalaykum AAathabayawmin AAatheem"},{"v":"26:136","t":"Qaloo sawaon AAalaynaawaAAathta am lam takun mina alwaAAitheen"}]