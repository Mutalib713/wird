[{"v":"26:207","t":"Ma aghna AAanhum ma kanooyumattaAAoon"},{"v":"26:208","t":"Wama ahlakna min qaryatin illalaha munthiroon"},{"v":"26:209","t":"Thikra wama kunnathalimeen"},{"v":"26:210","t":"Wama tanazzalat bihi ashshayateen"},{"v":"26:211","t":"Wama yanbaghee lahum wamayastateeAAoon"},{"v":"26:212","t":"Innahum AAani assamAAilamaAAzooloona"},{"v":"26:213","t":"Fala tadAAu maAAa Allahi ilahanakhara fatakoona mina almuAAaththabeen"},{"v":"26:214","t":"Waanthir AAasheerataka al-aqrabeen"},{"v":"26:215","t":"Wakhfid janahakalimani ittabaAAaka mina almu/mineen"},{"v":"26:216","t":"Fa-in AAasawka faqul innee baree-onmimma taAAmaloon"},{"v":"26:217","t":"Watawakkal AAala alAAazeezi arraheem"},{"v":"26:218","t":"Allathee yaraka heenataqoom"},{"v":"26:219","t":"Wataqallubaka fee assajideen"},{"v":"26:220","t":"Innahu huwa assameeAAu alAAaleem"},{"v":"26:221","t":"Hal onabbi-okum AAala man tanazzaluashshayateen"},{"v":"26:222","t":"Tanazzalu AAala kulli affakinatheem"},{"v":"26:223","t":"Yulqoona assamAAa waaktharuhum kathiboon"},{"v":"26:224","t":"WashshuAAaraoyattabiAAuhumu alghawoon"},{"v":"26:225","t":"Alam tara annahum fee kulli wadinyaheemoon"},{"v":"26:226","t":"Waannahum yaqooloona ma layafAAaloon"},{"v":"26:227","t":"Illa allatheena amanoowaAAamiloo assalihati wathakaroo Allahakatheeran wantasaroo min baAAdi ma thulimoowasayaAAlamu allatheena thalamoo ayyamunqalabin yanqaliboon"}]