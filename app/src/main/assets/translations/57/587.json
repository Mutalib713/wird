[{"v":"82:1","t":"Itha assamao infatarat"},{"v":"82:2","t":"Wa-itha alkawakibu intatharat"},{"v":"82:3","t":"Wa-itha albiharu fujjirat"},{"v":"82:4","t":"Wa-itha alqubooru buAAthirat"},{"v":"82:5","t":"AAalimat nafsun ma qaddamatwaakhkharat"},{"v":"82:6","t":"Ya ayyuha al-insanu magharraka birabbika alkareem"},{"v":"82:7","t":"Allathee khalaqaka fasawwakafaAAadalak"},{"v":"82:8","t":"Fee ayyi sooratin ma shaarakkabak"},{"v":"82:9","t":"Kalla bal tukaththiboona biddeen"},{"v":"82:10","t":"Wa-inna AAalaykum lahafitheen"},{"v":"82:11","t":"Kiraman katibeen"},{"v":"82:12","t":"YaAAlamoona ma tafAAaloon"},{"v":"82:13","t":"Inna al-abrara lafee naAAeem"},{"v":"82:14","t":"Wa-inna alfujjara lafee jaheem"},{"v":"82:15","t":"Yaslawnaha yawma addeen"},{"v":"82:16","t":"Wama hum AAanha bigha-ibeen"},{"v":"82:17","t":"Wama adraka ma yawmu addeeni"},{"v":"82:18","t":"Thumma ma adraka mayawmu addeen"},{"v":"82:19","t":"Yawma la tamliku nafsun linafsinshay-an wal-amru yawma-ithin lillah"},{"v":"83:1","t":"Waylun lilmutaffifeen"},{"v":"83:2","t":"Allatheena itha iktalooAAala annasi yastawfoon"},{"v":"83:3","t":"Wa-itha kaloohum aw wazanoohumyukhsiroon"},{"v":"83:4","t":"Ala yathunnu ola-ikaannahum mabAAoothoon"},{"v":"83:5","t":"Liyawmin AAatheem"},{"v":"83:6","t":"Yawma yaqoomu annasu lirabbialAAalameen"}]