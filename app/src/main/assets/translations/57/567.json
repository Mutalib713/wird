[{"v":"69:9","t":"Wajaa firAAawnu waman qablahu walmu/tafikatubilkhati-a"},{"v":"69:10","t":"FaAAasaw rasoola rabbihim faakhathahumakhthatan rabiya"},{"v":"69:11","t":"Inna lamma taghaalmao hamalnakum fee aljariya"},{"v":"69:12","t":"LinajAAalaha lakum tathkiratanwataAAiyaha othunun waAAiya"},{"v":"69:13","t":"Fa-itha nufikha fee assoorinafkhatun wahida"},{"v":"69:14","t":"Wahumilati al-ardu waljibalufadukkata dakkatan wahida"},{"v":"69:15","t":"Fayawma-ithin waqaAAati alwaqiAAa"},{"v":"69:16","t":"Wanshaqqati assamaofahiya yawma-ithin wahiya"},{"v":"69:17","t":"Walmalaku AAala arja-ihawayahmilu AAarsha rabbika fawqahum yawma-ithin thamaniya"},{"v":"69:18","t":"Yawma-ithin tuAAradoona latakhfa minkum khafiya"},{"v":"69:19","t":"Faamma man ootiya kitabahubiyameenihi fayaqoolu haomu iqraoo kitabiyah"},{"v":"69:20","t":"Innee thanantu annee mulaqinhisabiyah"},{"v":"69:21","t":"Fahuwa fee AAeeshatin radiya"},{"v":"69:22","t":"Fee jannatin AAaliya"},{"v":"69:23","t":"Qutoofuha daniya"},{"v":"69:24","t":"Kuloo washraboo hanee-an bimaaslaftum fee al-ayyami alkhaliya"},{"v":"69:25","t":"Waamma man ootiya kitabahubishimalihi fayaqoolu ya laytanee lam oota kitabiyah"},{"v":"69:26","t":"Walam adri ma hisabiyah"},{"v":"69:27","t":"Ya laytaha kanati alqadiya"},{"v":"69:28","t":"Ma aghna AAannee maliyah"},{"v":"69:29","t":"Halaka AAannee sultaniyah"},{"v":"69:30","t":"Khuthoohu faghullooh"},{"v":"69:31","t":"Thumma aljaheema sallooh"},{"v":"69:32","t":"Thumma fee silsilatin tharAAuhasabAAoona thiraAAan faslukooh"},{"v":"69:33","t":"Innahu kana la yu/minu billahialAAatheem"},{"v":"69:34","t":"Wala yahuddu AAalataAAami almiskeen"}]