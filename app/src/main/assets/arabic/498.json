[{"v":"44:40","t":"إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ"},{"v":"44:41","t":"يَوْمَ لَا يُغْنِي مَوْلًى عَن مَّوْلًى شَيْئًا وَلَا هُمْ يُنصَرُونَ"},{"v":"44:42","t":"إِلَّا مَن رَّحِمَ اللَّهُ ۚ إِنَّهُ هُوَ الْعَزِيزُ الرَّحِيمُ"},{"v":"44:43","t":"إِنَّ شَجَرَتَ الزَّقُّومِ"},{"v":"44:44","t":"طَعَامُ الْأَثِيمِ"},{"v":"44:45","t":"كَالْمُهْلِ يَغْلِي فِي الْبُطُونِ"},{"v":"44:46","t":"كَغَلْيِ الْحَمِيمِ"},{"v":"44:47","t":"خُذُوهُ فَاعْتِلُوهُ إِلَىٰ سَوَاءِ الْجَحِيمِ"},{"v":"44:48","t":"ثُمَّ صُبُّوا فَوْقَ رَأْسِهِ مِنْ عَذَابِ الْحَمِيمِ"},{"v":"44:49","t":"ذُقْ إِنَّكَ أَنتَ الْعَزِيزُ الْكَرِيمُ"},{"v":"44:50","t":"إِنَّ هَٰذَا مَا كُنتُم بِهِ تَمْتَرُونَ"},{"v":"44:51","t":"إِنَّ الْمُتَّقِينَ فِي مَقَامٍ أَمِينٍ"},{"v":"44:52","t":"فِي جَنَّاتٍ وَعُيُونٍ"},{"v":"44:53","t":"يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَابِلِينَ"},{"v":"44:54","t":"كَذَٰلِكَ وَزَوَّجْنَاهُم بِحُورٍ عِينٍ"},{"v":"44:55","t":"يَدْعُونَ فِيهَا بِكُلِّ فَاكِهَةٍ آمِنِينَ"},{"v":"44:56","t":"لَا يَذُوقُونَ فِيهَا الْمَوْتَ إِلَّا الْمَوْتَةَ الْأُولَىٰ ۖ وَوَقَاهُمْ عَذَابَ الْجَحِيمِ"},{"v":"44:57","t":"فَضْلًا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ الْفَوْزُ الْعَظِيمُ"},{"v":"44:58","t":"فَإِنَّمَا يَسَّرْنَاهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ"},{"v":"44:59","t":"فَارْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ"}]