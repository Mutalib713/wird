[{"v":"37:52","t":"يَقُولُ أَإِنَّكَ لَمِنَ الْمُصَدِّقِينَ"},{"v":"37:53","t":"أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَدِينُونَ"},{"v":"37:54","t":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"},{"v":"37:55","t":"فَاطَّلَعَ فَرَآهُ فِي سَوَاءِ الْجَحِيمِ"},{"v":"37:56","t":"قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِ"},{"v":"37:57","t":"وَلَوْلَا نِعْمَةُ رَبِّي لَكُنتُ مِنَ الْمُحْضَرِينَ"},{"v":"37:58","t":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},{"v":"37:59","t":"إِلَّا مَوْتَتَنَا الْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"},{"v":"37:60","t":"إِنَّ هَٰذَا لَهُوَ الْفَوْزُ الْعَظِيمُ"},{"v":"37:61","t":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ الْعَامِلُونَ"},{"v":"37:62","t":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ الزَّقُّومِ"},{"v":"37:63","t":"إِنَّا جَعَلْنَاهَا فِتْنَةً لِّلظَّالِمِينَ"},{"v":"37:64","t":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِي أَصْلِ الْجَحِيمِ"},{"v":"37:65","t":"طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ"},{"v":"37:66","t":"فَإِنَّهُمْ لَآكِلُونَ مِنْهَا فَمَالِئُونَ مِنْهَا الْبُطُونَ"},{"v":"37:67","t":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ"},{"v":"37:68","t":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى الْجَحِيمِ"},{"v":"37:69","t":"إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ"},{"v":"37:70","t":"فَهُمْ عَلَىٰ آثَارِهِمْ يُهْرَعُونَ"},{"v":"37:71","t":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ الْأَوَّلِينَ"},{"v":"37:72","t":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"},{"v":"37:73","t":"فَانظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنذَرِينَ"},{"v":"37:74","t":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"v":"37:75","t":"وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ"},{"v":"37:76","t":"وَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ الْكَرْبِ الْعَظِيمِ"}]