[{"v":"80:1","t":"عَبَسَ وَتَوَلَّىٰ"},{"v":"80:2","t":"أَن جَاءَهُ الْأَعْمَىٰ"},{"v":"80:3","t":"وَمَا يُدْرِيكَ لَعَلَّهُ يَزَّكَّىٰ"},{"v":"80:4","t":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ الذِّكْرَىٰ"},{"v":"80:5","t":"أَمَّا مَنِ اسْتَغْنَىٰ"},{"v":"80:6","t":"فَأَنتَ لَهُ تَصَدَّىٰ"},{"v":"80:7","t":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"},{"v":"80:8","t":"وَأَمَّا مَن جَاءَكَ يَسْعَىٰ"},{"v":"80:9","t":"وَهُوَ يَخْشَىٰ"},{"v":"80:10","t":"فَأَنتَ عَنْهُ تَلَهَّىٰ"},{"v":"80:11","t":"كَلَّا إِنَّهَا تَذْكِرَةٌ"},{"v":"80:12","t":"فَمَن شَاءَ ذَكَرَهُ"},{"v":"80:13","t":"فِي صُحُفٍ مُّكَرَّمَةٍ"},{"v":"80:14","t":"مَّرْفُوعَةٍ مُّطَهَّرَةٍ"},{"v":"80:15","t":"بِأَيْدِي سَفَرَةٍ"},{"v":"80:16","t":"كِرَامٍ بَرَرَةٍ"},{"v":"80:17","t":"قُتِلَ الْإِنسَانُ مَا أَكْفَرَهُ"},{"v":"80:18","t":"مِنْ أَيِّ شَيْءٍ خَلَقَهُ"},{"v":"80:19","t":"مِن نُّطْفَةٍ خَلَقَهُ فَقَدَّرَهُ"},{"v":"80:20","t":"ثُمَّ السَّبِيلَ يَسَّرَهُ"},{"v":"80:21","t":"ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ"},{"v":"80:22","t":"ثُمَّ إِذَا شَاءَ أَنشَرَهُ"},{"v":"80:23","t":"كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُ"},{"v":"80:24","t":"فَلْيَنظُرِ الْإِنسَانُ إِلَىٰ طَعَامِهِ"},{"v":"80:25","t":"أَنَّا صَبَبْنَا الْمَاءَ صَبًّا"},{"v":"80:26","t":"ثُمَّ شَقَقْنَا الْأَرْضَ شَقًّا"},{"v":"80:27","t":"فَأَنبَتْنَا فِيهَا حَبًّا"},{"v":"80:28","t":"وَعِنَبًا وَقَضْبًا"},{"v":"80:29","t":"وَزَيْتُونًا وَنَخْلًا"},{"v":"80:30","t":"وَحَدَائِقَ غُلْبًا"},{"v":"80:31","t":"وَفَاكِهَةً وَأَبًّا"},{"v":"80:32","t":"مَّتَاعًا لَّكُمْ وَلِأَنْعَامِكُمْ"},{"v":"80:33","t":"فَإِذَا جَاءَتِ الصَّاخَّةُ"},{"v":"80:34","t":"يَوْمَ يَفِرُّ الْمَرْءُ مِنْ أَخِيهِ"},{"v":"80:35","t":"وَأُمِّهِ وَأَبِيهِ"},{"v":"80:36","t":"وَصَاحِبَتِهِ وَبَنِيهِ"},{"v":"80:37","t":"لِكُلِّ امْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"},{"v":"80:38","t":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"},{"v":"80:39","t":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ"},{"v":"80:40","t":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"},{"v":"80:41","t":"تَرْهَقُهَا قَتَرَةٌ"},{"v":"80:42","t":"أُولَٰئِكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ"}]