[{"v":"78:1","t":"عَمَّ يَتَسَاءَلُونَ"},{"v":"78:2","t":"عَنِ النَّبَإِ الْعَظِيمِ"},{"v":"78:3","t":"الَّذِي هُمْ فِيهِ مُخْتَلِفُونَ"},{"v":"78:4","t":"كَلَّا سَيَعْلَمُونَ"},{"v":"78:5","t":"ثُمَّ كَلَّا سَيَعْلَمُونَ"},{"v":"78:6","t":"أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا"},{"v":"78:7","t":"وَالْجِبَالَ أَوْتَادًا"},{"v":"78:8","t":"وَخَلَقْنَاكُمْ أَزْوَاجًا"},{"v":"78:9","t":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"},{"v":"78:10","t":"وَجَعَلْنَا اللَّيْلَ لِبَاسًا"},{"v":"78:11","t":"وَجَعَلْنَا النَّهَارَ مَعَاشًا"},{"v":"78:12","t":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا"},{"v":"78:13","t":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا"},{"v":"78:14","t":"وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا"},{"v":"78:15","t":"لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا"},{"v":"78:16","t":"وَجَنَّاتٍ أَلْفَافًا"},{"v":"78:17","t":"إِنَّ يَوْمَ الْفَصْلِ كَانَ مِيقَاتًا"},{"v":"78:18","t":"يَوْمَ يُنفَخُ فِي الصُّورِ فَتَأْتُونَ أَفْوَاجًا"},{"v":"78:19","t":"وَفُتِحَتِ السَّمَاءُ فَكَانَتْ أَبْوَابًا"},{"v":"78:20","t":"وَسُيِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًا"},{"v":"78:21","t":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا"},{"v":"78:22","t":"لِّلطَّاغِينَ مَآبًا"},{"v":"78:23","t":"لَّابِثِينَ فِيهَا أَحْقَابًا"},{"v":"78:24","t":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا"},{"v":"78:25","t":"إِلَّا حَمِيمًا وَغَسَّاقًا"},{"v":"78:26","t":"جَزَاءً وِفَاقًا"},{"v":"78:27","t":"إِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَابًا"},{"v":"78:28","t":"وَكَذَّبُوا بِآيَاتِنَا كِذَّابًا"},{"v":"78:29","t":"وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ كِتَابًا"},{"v":"78:30","t":"فَذُوقُوا فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا"}]