[{"v":"83:35","t":"عَلَى الْأَرَائِكِ يَنظُرُونَ"},{"v":"83:36","t":"هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوا يَفْعَلُونَ"},{"v":"84:1","t":"إِذَا السَّمَاءُ انشَقَّتْ"},{"v":"84:2","t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"v":"84:3","t":"وَإِذَا الْأَرْضُ مُدَّتْ"},{"v":"84:4","t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"v":"84:5","t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"v":"84:6","t":"يَا أَيُّهَا الْإِنسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ"},{"v":"84:7","t":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ"},{"v":"84:8","t":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"v":"84:9","t":"وَيَنقَلِبُ إِلَىٰ أَهْلِهِ مَسْرُورًا"},{"v":"84:10","t":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ"},{"v":"84:11","t":"فَسَوْفَ يَدْعُو ثُبُورًا"},{"v":"84:12","t":"وَيَصْلَىٰ سَعِيرًا"},{"v":"84:13","t":"إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا"},{"v":"84:14","t":"إِنَّهُ ظَنَّ أَن لَّن يَحُورَ"},{"v":"84:15","t":"بَلَىٰ إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا"},{"v":"84:16","t":"فَلَا أُقْسِمُ بِالشَّفَقِ"},{"v":"84:17","t":"وَاللَّيْلِ وَمَا وَسَقَ"},{"v":"84:18","t":"وَالْقَمَرِ إِذَا اتَّسَقَ"},{"v":"84:19","t":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"},{"v":"84:20","t":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"v":"84:21","t":"وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ"},{"v":"84:22","t":"بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ"},{"v":"84:23","t":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"v":"84:24","t":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"},{"v":"84:25","t":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"}]