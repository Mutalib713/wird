[{"v":"81:1","t":"إِذَا الشَّمْسُ كُوِّرَتْ"},{"v":"81:2","t":"وَإِذَا النُّجُومُ انكَدَرَتْ"},{"v":"81:3","t":"وَإِذَا الْجِبَالُ سُيِّرَتْ"},{"v":"81:4","t":"وَإِذَا الْعِشَارُ عُطِّلَتْ"},{"v":"81:5","t":"وَإِذَا الْوُحُوشُ حُشِرَتْ"},{"v":"81:6","t":"وَإِذَا الْبِحَارُ سُجِّرَتْ"},{"v":"81:7","t":"وَإِذَا النُّفُوسُ زُوِّجَتْ"},{"v":"81:8","t":"وَإِذَا الْمَوْءُودَةُ سُئِلَتْ"},{"v":"81:9","t":"بِأَيِّ ذَنبٍ قُتِلَتْ"},{"v":"81:10","t":"وَإِذَا الصُّحُفُ نُشِرَتْ"},{"v":"81:11","t":"وَإِذَا السَّمَاءُ كُشِطَتْ"},{"v":"81:12","t":"وَإِذَا الْجَحِيمُ سُعِّرَتْ"},{"v":"81:13","t":"وَإِذَا الْجَنَّةُ أُزْلِفَتْ"},{"v":"81:14","t":"عَلِمَتْ نَفْسٌ مَّا أَحْضَرَتْ"},{"v":"81:15","t":"فَلَا أُقْسِمُ بِالْخُنَّسِ"},{"v":"81:16","t":"الْجَوَارِ الْكُنَّسِ"},{"v":"81:17","t":"وَاللَّيْلِ إِذَا عَسْعَسَ"},{"v":"81:18","t":"وَالصُّبْحِ إِذَا تَنَفَّسَ"},{"v":"81:19","t":"إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"v":"81:20","t":"ذِي قُوَّةٍ عِندَ ذِي الْعَرْشِ مَكِينٍ"},{"v":"81:21","t":"مُّطَاعٍ ثَمَّ أَمِينٍ"},{"v":"81:22","t":"وَمَا صَاحِبُكُم بِمَجْنُونٍ"},{"v":"81:23","t":"وَلَقَدْ رَآهُ بِالْأُفُقِ الْمُبِينِ"},{"v":"81:24","t":"وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِينٍ"},{"v":"81:25","t":"وَمَا هُوَ بِقَوْلِ شَيْطَانٍ رَّجِيمٍ"},{"v":"81:26","t":"فَأَيْنَ تَذْهَبُونَ"},{"v":"81:27","t":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَالَمِينَ"},{"v":"81:28","t":"لِمَن شَاءَ مِنكُمْ أَن يَسْتَقِيمَ"},{"v":"81:29","t":"وَمَا تَشَاءُونَ إِلَّا أَن يَشَاءَ اللَّهُ رَبُّ الْعَالَمِينَ"}]