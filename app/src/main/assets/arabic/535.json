[{"v":"56:17","t":"يَطُوفُ عَلَيْهِمْ وِلْدَانٌ مُّخَلَّدُونَ"},{"v":"56:18","t":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ"},{"v":"56:19","t":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ"},{"v":"56:20","t":"وَفَاكِهَةٍ مِّمَّا يَتَخَيَّرُونَ"},{"v":"56:21","t":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ"},{"v":"56:22","t":"وَحُورٌ عِينٌ"},{"v":"56:23","t":"كَأَمْثَالِ اللُّؤْلُؤِ الْمَكْنُونِ"},{"v":"56:24","t":"جَزَاءً بِمَا كَانُوا يَعْمَلُونَ"},{"v":"56:25","t":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا"},{"v":"56:26","t":"إِلَّا قِيلًا سَلَامًا سَلَامًا"},{"v":"56:27","t":"وَأَصْحَابُ الْيَمِينِ مَا أَصْحَابُ الْيَمِينِ"},{"v":"56:28","t":"فِي سِدْرٍ مَّخْضُودٍ"},{"v":"56:29","t":"وَطَلْحٍ مَّنضُودٍ"},{"v":"56:30","t":"وَظِلٍّ مَّمْدُودٍ"},{"v":"56:31","t":"وَمَاءٍ مَّسْكُوبٍ"},{"v":"56:32","t":"وَفَاكِهَةٍ كَثِيرَةٍ"},{"v":"56:33","t":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ"},{"v":"56:34","t":"وَفُرُشٍ مَّرْفُوعَةٍ"},{"v":"56:35","t":"إِنَّا أَنشَأْنَاهُنَّ إِنشَاءً"},{"v":"56:36","t":"فَجَعَلْنَاهُنَّ أَبْكَارًا"},{"v":"56:37","t":"عُرُبًا أَتْرَابًا"},{"v":"56:38","t":"لِّأَصْحَابِ الْيَمِينِ"},{"v":"56:39","t":"ثُلَّةٌ مِّنَ الْأَوَّلِينَ"},{"v":"56:40","t":"وَثُلَّةٌ مِّنَ الْآخِرِينَ"},{"v":"56:41","t":"وَأَصْحَابُ الشِّمَالِ مَا أَصْحَابُ الشِّمَالِ"},{"v":"56:42","t":"فِي سَمُومٍ وَحَمِيمٍ"},{"v":"56:43","t":"وَظِلٍّ مِّن يَحْمُومٍ"},{"v":"56:44","t":"لَّا بَارِدٍ وَلَا كَرِيمٍ"},{"v":"56:45","t":"إِنَّهُمْ كَانُوا قَبْلَ ذَٰلِكَ مُتْرَفِينَ"},{"v":"56:46","t":"وَكَانُوا يُصِرُّونَ عَلَى الْحِنثِ الْعَظِيمِ"},{"v":"56:47","t":"وَكَانُوا يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ"},{"v":"56:48","t":"أَوَآبَاؤُنَا الْأَوَّلُونَ"},{"v":"56:49","t":"قُلْ إِنَّ الْأَوَّلِينَ وَالْآخِرِينَ"},{"v":"56:50","t":"لَمَجْمُوعُونَ إِلَىٰ مِيقَاتِ يَوْمٍ مَّعْلُومٍ"}]