[{"v":"37:154","t":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ"},{"v":"37:155","t":"أَفَلَا تَذَكَّرُونَ"},{"v":"37:156","t":"أَمْ لَكُمْ سُلْطَانٌ مُّبِينٌ"},{"v":"37:157","t":"فَأْتُوا بِكِتَابِكُمْ إِن كُنتُمْ صَادِقِينَ"},{"v":"37:158","t":"وَجَعَلُوا بَيْنَهُ وَبَيْنَ الْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ الْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"},{"v":"37:159","t":"سُبْحَانَ اللَّهِ عَمَّا يَصِفُونَ"},{"v":"37:160","t":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"v":"37:161","t":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},{"v":"37:162","t":"مَا أَنتُمْ عَلَيْهِ بِفَاتِنِينَ"},{"v":"37:163","t":"إِلَّا مَنْ هُوَ صَالِ الْجَحِيمِ"},{"v":"37:164","t":"وَمَا مِنَّا إِلَّا لَهُ مَقَامٌ مَّعْلُومٌ"},{"v":"37:165","t":"وَإِنَّا لَنَحْنُ الصَّافُّونَ"},{"v":"37:166","t":"وَإِنَّا لَنَحْنُ الْمُسَبِّحُونَ"},{"v":"37:167","t":"وَإِن كَانُوا لَيَقُولُونَ"},{"v":"37:168","t":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ الْأَوَّلِينَ"},{"v":"37:169","t":"لَكُنَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"v":"37:170","t":"فَكَفَرُوا بِهِ ۖ فَسَوْفَ يَعْلَمُونَ"},{"v":"37:171","t":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلِينَ"},{"v":"37:172","t":"إِنَّهُمْ لَهُمُ الْمَنصُورُونَ"},{"v":"37:173","t":"وَإِنَّ جُندَنَا لَهُمُ الْغَالِبُونَ"},{"v":"37:174","t":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"v":"37:175","t":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"},{"v":"37:176","t":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"v":"37:177","t":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَاءَ صَبَاحُ الْمُنذَرِينَ"},{"v":"37:178","t":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"v":"37:179","t":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},{"v":"37:180","t":"سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ"},{"v":"37:181","t":"وَسَلَامٌ عَلَى الْمُرْسَلِينَ"},{"v":"37:182","t":"وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"}]