[{"v":"54:50","t":"وَمَا أَمْرُنَا إِلَّا وَاحِدَةٌ كَلَمْحٍ بِالْبَصَرِ"},{"v":"54:51","t":"وَلَقَدْ أَهْلَكْنَا أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍ"},{"v":"54:52","t":"وَكُلُّ شَيْءٍ فَعَلُوهُ فِي الزُّبُرِ"},{"v":"54:53","t":"وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُّسْتَطَرٌ"},{"v":"54:54","t":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَهَرٍ"},{"v":"54:55","t":"فِي مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍ مُّقْتَدِرٍ"},{"v":"55:1","t":"الرَّحْمَٰنُ"},{"v":"55:2","t":"عَلَّمَ الْقُرْآنَ"},{"v":"55:3","t":"خَلَقَ الْإِنسَانَ"},{"v":"55:4","t":"عَلَّمَهُ الْبَيَانَ"},{"v":"55:5","t":"الشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍ"},{"v":"55:6","t":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَانِ"},{"v":"55:7","t":"وَالسَّمَاءَ رَفَعَهَا وَوَضَعَ الْمِيزَانَ"},{"v":"55:8","t":"أَلَّا تَطْغَوْا فِي الْمِيزَانِ"},{"v":"55:9","t":"وَأَقِيمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْمِيزَانَ"},{"v":"55:10","t":"وَالْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},{"v":"55:11","t":"فِيهَا فَاكِهَةٌ وَالنَّخْلُ ذَاتُ الْأَكْمَامِ"},{"v":"55:12","t":"وَالْحَبُّ ذُو الْعَصْفِ وَالرَّيْحَانُ"},{"v":"55:13","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:14","t":"خَلَقَ الْإِنسَانَ مِن صَلْصَالٍ كَالْفَخَّارِ"},{"v":"55:15","t":"وَخَلَقَ الْجَانَّ مِن مَّارِجٍ مِّن نَّارٍ"},{"v":"55:16","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"}]