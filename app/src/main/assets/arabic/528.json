[{"v":"53:45","t":"وَأَنَّهُ خَلَقَ الزَّوْجَيْنِ الذَّكَرَ وَالْأُنثَىٰ"},{"v":"53:46","t":"مِن نُّطْفَةٍ إِذَا تُمْنَىٰ"},{"v":"53:47","t":"وَأَنَّ عَلَيْهِ النَّشْأَةَ الْأُخْرَىٰ"},{"v":"53:48","t":"وَأَنَّهُ هُوَ أَغْنَىٰ وَأَقْنَىٰ"},{"v":"53:49","t":"وَأَنَّهُ هُوَ رَبُّ الشِّعْرَىٰ"},{"v":"53:50","t":"وَأَنَّهُ أَهْلَكَ عَادًا الْأُولَىٰ"},{"v":"53:51","t":"وَثَمُودَ فَمَا أَبْقَىٰ"},{"v":"53:52","t":"وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا هُمْ أَظْلَمَ وَأَطْغَىٰ"},{"v":"53:53","t":"وَالْمُؤْتَفِكَةَ أَهْوَىٰ"},{"v":"53:54","t":"فَغَشَّاهَا مَا غَشَّىٰ"},{"v":"53:55","t":"فَبِأَيِّ آلَاءِ رَبِّكَ تَتَمَارَىٰ"},{"v":"53:56","t":"هَٰذَا نَذِيرٌ مِّنَ النُّذُرِ الْأُولَىٰ"},{"v":"53:57","t":"أَزِفَتِ الْآزِفَةُ"},{"v":"53:58","t":"لَيْسَ لَهَا مِن دُونِ اللَّهِ كَاشِفَةٌ"},{"v":"53:59","t":"أَفَمِنْ هَٰذَا الْحَدِيثِ تَعْجَبُونَ"},{"v":"53:60","t":"وَتَضْحَكُونَ وَلَا تَبْكُونَ"},{"v":"53:61","t":"وَأَنتُمْ سَامِدُونَ"},{"v":"53:62","t":"فَاسْجُدُوا لِلَّهِ وَاعْبُدُوا"},{"v":"54:1","t":"اقْتَرَبَتِ السَّاعَةُ وَانشَقَّ الْقَمَرُ"},{"v":"54:2","t":"وَإِن يَرَوْا آيَةً يُعْرِضُوا وَيَقُولُوا سِحْرٌ مُّسْتَمِرٌّ"},{"v":"54:3","t":"وَكَذَّبُوا وَاتَّبَعُوا أَهْوَاءَهُمْ ۚ وَكُلُّ أَمْرٍ مُّسْتَقِرٌّ"},{"v":"54:4","t":"وَلَقَدْ جَاءَهُم مِّنَ الْأَنبَاءِ مَا فِيهِ مُزْدَجَرٌ"},{"v":"54:5","t":"حِكْمَةٌ بَالِغَةٌ ۖ فَمَا تُغْنِ النُّذُرُ"},{"v":"54:6","t":"فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ الدَّاعِ إِلَىٰ شَيْءٍ نُّكُرٍ"}]