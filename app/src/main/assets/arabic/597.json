[{"v":"95:1","t":"وَالتِّينِ وَالزَّيْتُونِ"},{"v":"95:2","t":"وَطُورِ سِينِينَ"},{"v":"95:3","t":"وَهَٰذَا الْبَلَدِ الْأَمِينِ"},{"v":"95:4","t":"لَقَدْ خَلَقْنَا الْإِنسَانَ فِي أَحْسَنِ تَقْوِيمٍ"},{"v":"95:5","t":"ثُمَّ رَدَدْنَاهُ أَسْفَلَ سَافِلِينَ"},{"v":"95:6","t":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"},{"v":"95:7","t":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِ"},{"v":"95:8","t":"أَلَيْسَ اللَّهُ بِأَحْكَمِ الْحَاكِمِينَ"},{"v":"96:1","t":"اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ"},{"v":"96:2","t":"خَلَقَ الْإِنسَانَ مِنْ عَلَقٍ"},{"v":"96:3","t":"اقْرَأْ وَرَبُّكَ الْأَكْرَمُ"},{"v":"96:4","t":"الَّذِي عَلَّمَ بِالْقَلَمِ"},{"v":"96:5","t":"عَلَّمَ الْإِنسَانَ مَا لَمْ يَعْلَمْ"},{"v":"96:6","t":"كَلَّا إِنَّ الْإِنسَانَ لَيَطْغَىٰ"},{"v":"96:7","t":"أَن رَّآهُ اسْتَغْنَىٰ"},{"v":"96:8","t":"إِنَّ إِلَىٰ رَبِّكَ الرُّجْعَىٰ"},{"v":"96:9","t":"أَرَأَيْتَ الَّذِي يَنْهَىٰ"},{"v":"96:10","t":"عَبْدًا إِذَا صَلَّىٰ"},{"v":"96:11","t":"أَرَأَيْتَ إِن كَانَ عَلَى الْهُدَىٰ"},{"v":"96:12","t":"أَوْ أَمَرَ بِالتَّقْوَىٰ"},{"v":"96:13","t":"أَرَأَيْتَ إِن كَذَّبَ وَتَوَلَّىٰ"},{"v":"96:14","t":"أَلَمْ يَعْلَم بِأَنَّ اللَّهَ يَرَىٰ"},{"v":"96:15","t":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ"},{"v":"96:16","t":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ"},{"v":"96:17","t":"فَلْيَدْعُ نَادِيَهُ"},{"v":"96:18","t":"سَنَدْعُ الزَّبَانِيَةَ"},{"v":"96:19","t":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِب"}]