[{"v":"70:11","t":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ الْمُجْرِمُ لَوْ يَفْتَدِي مِنْ عَذَابِ يَوْمِئِذٍ بِبَنِيهِ"},{"v":"70:12","t":"وَصَاحِبَتِهِ وَأَخِيهِ"},{"v":"70:13","t":"وَفَصِيلَتِهِ الَّتِي تُؤْوِيهِ"},{"v":"70:14","t":"وَمَن فِي الْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ"},{"v":"70:15","t":"كَلَّا ۖ إِنَّهَا لَظَىٰ"},{"v":"70:16","t":"نَزَّاعَةً لِّلشَّوَىٰ"},{"v":"70:17","t":"تَدْعُو مَنْ أَدْبَرَ وَتَوَلَّىٰ"},{"v":"70:18","t":"وَجَمَعَ فَأَوْعَىٰ"},{"v":"70:19","t":"إِنَّ الْإِنسَانَ خُلِقَ هَلُوعًا"},{"v":"70:20","t":"إِذَا مَسَّهُ الشَّرُّ جَزُوعًا"},{"v":"70:21","t":"وَإِذَا مَسَّهُ الْخَيْرُ مَنُوعًا"},{"v":"70:22","t":"إِلَّا الْمُصَلِّينَ"},{"v":"70:23","t":"الَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَائِمُونَ"},{"v":"70:24","t":"وَالَّذِينَ فِي أَمْوَالِهِمْ حَقٌّ مَّعْلُومٌ"},{"v":"70:25","t":"لِّلسَّائِلِ وَالْمَحْرُومِ"},{"v":"70:26","t":"وَالَّذِينَ يُصَدِّقُونَ بِيَوْمِ الدِّينِ"},{"v":"70:27","t":"وَالَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"},{"v":"70:28","t":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ"},{"v":"70:29","t":"وَالَّذِينَ هُمْ لِفُرُوجِهِمْ حَافِظُونَ"},{"v":"70:30","t":"إِلَّا عَلَىٰ أَزْوَاجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَانُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"},{"v":"70:31","t":"فَمَنِ ابْتَغَىٰ وَرَاءَ ذَٰلِكَ فَأُولَٰئِكَ هُمُ الْعَادُونَ"},{"v":"70:32","t":"وَالَّذِينَ هُمْ لِأَمَانَاتِهِمْ وَعَهْدِهِمْ رَاعُونَ"},{"v":"70:33","t":"وَالَّذِينَ هُم بِشَهَادَاتِهِمْ قَائِمُونَ"},{"v":"70:34","t":"وَالَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"},{"v":"70:35","t":"أُولَٰئِكَ فِي جَنَّاتٍ مُّكْرَمُونَ"},{"v":"70:36","t":"فَمَالِ الَّذِينَ كَفَرُوا قِبَلَكَ مُهْطِعِينَ"},{"v":"70:37","t":"عَنِ الْيَمِينِ وَعَنِ الشِّمَالِ عِزِينَ"},{"v":"70:38","t":"أَيَطْمَعُ كُلُّ امْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ"},{"v":"70:39","t":"كَلَّا ۖ إِنَّا خَلَقْنَاهُم مِّمَّا يَعْلَمُونَ"}]