[{"v":"55:41","t":"يُعْرَفُ الْمُجْرِمُونَ بِسِيمَاهُمْ فَيُؤْخَذُ بِالنَّوَاصِي وَالْأَقْدَامِ"},{"v":"55:42","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:43","t":"هَٰذِهِ جَهَنَّمُ الَّتِي يُكَذِّبُ بِهَا الْمُجْرِمُونَ"},{"v":"55:44","t":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ آنٍ"},{"v":"55:45","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:46","t":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِ جَنَّتَانِ"},{"v":"55:47","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:48","t":"ذَوَاتَا أَفْنَانٍ"},{"v":"55:49","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:50","t":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ"},{"v":"55:51","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:52","t":"فِيهِمَا مِن كُلِّ فَاكِهَةٍ زَوْجَانِ"},{"v":"55:53","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:54","t":"مُتَّكِئِينَ عَلَىٰ فُرُشٍ بَطَائِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى الْجَنَّتَيْنِ دَانٍ"},{"v":"55:55","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:56","t":"فِيهِنَّ قَاصِرَاتُ الطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَانٌّ"},{"v":"55:57","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:58","t":"كَأَنَّهُنَّ الْيَاقُوتُ وَالْمَرْجَانُ"},{"v":"55:59","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:60","t":"هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ"},{"v":"55:61","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:62","t":"وَمِن دُونِهِمَا جَنَّتَانِ"},{"v":"55:63","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:64","t":"مُدْهَامَّتَانِ"},{"v":"55:65","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:66","t":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ"},{"v":"55:67","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"}]