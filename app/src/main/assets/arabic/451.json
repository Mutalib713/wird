[{"v":"37:127","t":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"},{"v":"37:128","t":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"v":"37:129","t":"وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ"},{"v":"37:130","t":"سَلَامٌ عَلَىٰ إِلْ يَاسِينَ"},{"v":"37:131","t":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ"},{"v":"37:132","t":"إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ"},{"v":"37:133","t":"وَإِنَّ لُوطًا لَّمِنَ الْمُرْسَلِينَ"},{"v":"37:134","t":"إِذْ نَجَّيْنَاهُ وَأَهْلَهُ أَجْمَعِينَ"},{"v":"37:135","t":"إِلَّا عَجُوزًا فِي الْغَابِرِينَ"},{"v":"37:136","t":"ثُمَّ دَمَّرْنَا الْآخَرِينَ"},{"v":"37:137","t":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"},{"v":"37:138","t":"وَبِاللَّيْلِ ۗ أَفَلَا تَعْقِلُونَ"},{"v":"37:139","t":"وَإِنَّ يُونُسَ لَمِنَ الْمُرْسَلِينَ"},{"v":"37:140","t":"إِذْ أَبَقَ إِلَى الْفُلْكِ الْمَشْحُونِ"},{"v":"37:141","t":"فَسَاهَمَ فَكَانَ مِنَ الْمُدْحَضِينَ"},{"v":"37:142","t":"فَالْتَقَمَهُ الْحُوتُ وَهُوَ مُلِيمٌ"},{"v":"37:143","t":"فَلَوْلَا أَنَّهُ كَانَ مِنَ الْمُسَبِّحِينَ"},{"v":"37:144","t":"لَلَبِثَ فِي بَطْنِهِ إِلَىٰ يَوْمِ يُبْعَثُونَ"},{"v":"37:145","t":"فَنَبَذْنَاهُ بِالْعَرَاءِ وَهُوَ سَقِيمٌ"},{"v":"37:146","t":"وَأَنبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ"},{"v":"37:147","t":"وَأَرْسَلْنَاهُ إِلَىٰ مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ"},{"v":"37:148","t":"فَآمَنُوا فَمَتَّعْنَاهُمْ إِلَىٰ حِينٍ"},{"v":"37:149","t":"فَاسْتَفْتِهِمْ أَلِرَبِّكَ الْبَنَاتُ وَلَهُمُ الْبَنُونَ"},{"v":"37:150","t":"أَمْ خَلَقْنَا الْمَلَائِكَةَ إِنَاثًا وَهُمْ شَاهِدُونَ"},{"v":"37:151","t":"أَلَا إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"},{"v":"37:152","t":"وَلَدَ اللَّهُ وَإِنَّهُمْ لَكَاذِبُونَ"},{"v":"37:153","t":"أَصْطَفَى الْبَنَاتِ عَلَى الْبَنِينَ"}]