[{"v":"55:68","t":"فِيهِمَا فَاكِهَةٌ وَنَخْلٌ وَرُمَّانٌ"},{"v":"55:69","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:70","t":"فِيهِنَّ خَيْرَاتٌ حِسَانٌ"},{"v":"55:71","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:72","t":"حُورٌ مَّقْصُورَاتٌ فِي الْخِيَامِ"},{"v":"55:73","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:74","t":"لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَانٌّ"},{"v":"55:75","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:76","t":"مُتَّكِئِينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِيٍّ حِسَانٍ"},{"v":"55:77","t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"v":"55:78","t":"تَبَارَكَ اسْمُ رَبِّكَ ذِي الْجَلَالِ وَالْإِكْرَامِ"},{"v":"56:1","t":"إِذَا وَقَعَتِ الْوَاقِعَةُ"},{"v":"56:2","t":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"},{"v":"56:3","t":"خَافِضَةٌ رَّافِعَةٌ"},{"v":"56:4","t":"إِذَا رُجَّتِ الْأَرْضُ رَجًّا"},{"v":"56:5","t":"وَبُسَّتِ الْجِبَالُ بَسًّا"},{"v":"56:6","t":"فَكَانَتْ هَبَاءً مُّنبَثًّا"},{"v":"56:7","t":"وَكُنتُمْ أَزْوَاجًا ثَلَاثَةً"},{"v":"56:8","t":"فَأَصْحَابُ الْمَيْمَنَةِ مَا أَصْحَابُ الْمَيْمَنَةِ"},{"v":"56:9","t":"وَأَصْحَابُ الْمَشْأَمَةِ مَا أَصْحَابُ الْمَشْأَمَةِ"},{"v":"56:10","t":"وَالسَّابِقُونَ السَّابِقُونَ"},{"v":"56:11","t":"أُولَٰئِكَ الْمُقَرَّبُونَ"},{"v":"56:12","t":"فِي جَنَّاتِ النَّعِيمِ"},{"v":"56:13","t":"ثُلَّةٌ مِّنَ الْأَوَّلِينَ"},{"v":"56:14","t":"وَقَلِيلٌ مِّنَ الْآخِرِينَ"},{"v":"56:15","t":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ"},{"v":"56:16","t":"مُّتَّكِئِينَ عَلَيْهَا مُتَقَابِلِينَ"}]