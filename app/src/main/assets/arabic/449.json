[{"v":"37:77","t":"وَجَعَلْنَا ذُرِّيَّتَهُ هُمُ الْبَاقِينَ"},{"v":"37:78","t":"وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ"},{"v":"37:79","t":"سَلَامٌ عَلَىٰ نُوحٍ فِي الْعَالَمِينَ"},{"v":"37:80","t":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ"},{"v":"37:81","t":"إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ"},{"v":"37:82","t":"ثُمَّ أَغْرَقْنَا الْآخَرِينَ"},{"v":"37:83","t":"وَإِنَّ مِن شِيعَتِهِ لَإِبْرَاهِيمَ"},{"v":"37:84","t":"إِذْ جَاءَ رَبَّهُ بِقَلْبٍ سَلِيمٍ"},{"v":"37:85","t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِ مَاذَا تَعْبُدُونَ"},{"v":"37:86","t":"أَئِفْكًا آلِهَةً دُونَ اللَّهِ تُرِيدُونَ"},{"v":"37:87","t":"فَمَا ظَنُّكُم بِرَبِّ الْعَالَمِينَ"},{"v":"37:88","t":"فَنَظَرَ نَظْرَةً فِي النُّجُومِ"},{"v":"37:89","t":"فَقَالَ إِنِّي سَقِيمٌ"},{"v":"37:90","t":"فَتَوَلَّوْا عَنْهُ مُدْبِرِينَ"},{"v":"37:91","t":"فَرَاغَ إِلَىٰ آلِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"},{"v":"37:92","t":"مَا لَكُمْ لَا تَنطِقُونَ"},{"v":"37:93","t":"فَرَاغَ عَلَيْهِمْ ضَرْبًا بِالْيَمِينِ"},{"v":"37:94","t":"فَأَقْبَلُوا إِلَيْهِ يَزِفُّونَ"},{"v":"37:95","t":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"},{"v":"37:96","t":"وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"},{"v":"37:97","t":"قَالُوا ابْنُوا لَهُ بُنْيَانًا فَأَلْقُوهُ فِي الْجَحِيمِ"},{"v":"37:98","t":"فَأَرَادُوا بِهِ كَيْدًا فَجَعَلْنَاهُمُ الْأَسْفَلِينَ"},{"v":"37:99","t":"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهْدِينِ"},{"v":"37:100","t":"رَبِّ هَبْ لِي مِنَ الصَّالِحِينَ"},{"v":"37:101","t":"فَبَشَّرْنَاهُ بِغُلَامٍ حَلِيمٍ"},{"v":"37:102","t":"فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ قَالَ يَا بُنَيَّ إِنِّي أَرَىٰ فِي الْمَنَامِ أَنِّي أَذْبَحُكَ فَانظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَا أَبَتِ افْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِي إِن شَاءَ اللَّهُ مِنَ الصَّابِرِينَ"}]