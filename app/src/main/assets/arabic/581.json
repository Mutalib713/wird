[{"v":"77:20","t":"أَلَمْ نَخْلُقكُّم مِّن مَّاءٍ مَّهِينٍ"},{"v":"77:21","t":"فَجَعَلْنَاهُ فِي قَرَارٍ مَّكِينٍ"},{"v":"77:22","t":"إِلَىٰ قَدَرٍ مَّعْلُومٍ"},{"v":"77:23","t":"فَقَدَرْنَا فَنِعْمَ الْقَادِرُونَ"},{"v":"77:24","t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":"77:25","t":"أَلَمْ نَجْعَلِ الْأَرْضَ كِفَاتًا"},{"v":"77:26","t":"أَحْيَاءً وَأَمْوَاتًا"},{"v":"77:27","t":"وَجَعَلْنَا فِيهَا رَوَاسِيَ شَامِخَاتٍ وَأَسْقَيْنَاكُم مَّاءً فُرَاتًا"},{"v":"77:28","t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":"77:29","t":"انطَلِقُوا إِلَىٰ مَا كُنتُم بِهِ تُكَذِّبُونَ"},{"v":"77:30","t":"انطَلِقُوا إِلَىٰ ظِلٍّ ذِي ثَلَاثِ شُعَبٍ"},{"v":"77:31","t":"لَّا ظَلِيلٍ وَلَا يُغْنِي مِنَ اللَّهَبِ"},{"v":"77:32","t":"إِنَّهَا تَرْمِي بِشَرَرٍ كَالْقَصْرِ"},{"v":"77:33","t":"كَأَنَّهُ جِمَالَتٌ صُفْرٌ"},{"v":"77:34","t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":"77:35","t":"هَٰذَا يَوْمُ لَا يَنطِقُونَ"},{"v":"77:36","t":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"},{"v":"77:37","t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":"77:38","t":"هَٰذَا يَوْمُ الْفَصْلِ ۖ جَمَعْنَاكُمْ وَالْأَوَّلِينَ"},{"v":"77:39","t":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"},{"v":"77:40","t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":"77:41","t":"إِنَّ الْمُتَّقِينَ فِي ظِلَالٍ وَعُيُونٍ"},{"v":"77:42","t":"وَفَوَاكِهَ مِمَّا يَشْتَهُونَ"},{"v":"77:43","t":"كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنتُمْ تَعْمَلُونَ"},{"v":"77:44","t":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ"},{"v":"77:45","t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":"77:46","t":"كُلُوا وَتَمَتَّعُوا قَلِيلًا إِنَّكُم مُّجْرِمُونَ"},{"v":"77:47","t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":"77:48","t":"وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ"},{"v":"77:49","t":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"v":"77:50","t":"فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ"}]