[{"v":"92:15","t":"لَا يَصْلَاهَا إِلَّا الْأَشْقَى"},{"v":"92:16","t":"الَّذِي كَذَّبَ وَتَوَلَّىٰ"},{"v":"92:17","t":"وَسَيُجَنَّبُهَا الْأَتْقَى"},{"v":"92:18","t":"الَّذِي يُؤْتِي مَالَهُ يَتَزَكَّىٰ"},{"v":"92:19","t":"وَمَا لِأَحَدٍ عِندَهُ مِن نِّعْمَةٍ تُجْزَىٰ"},{"v":"92:20","t":"إِلَّا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَىٰ"},{"v":"92:21","t":"وَلَسَوْفَ يَرْضَىٰ"},{"v":"93:1","t":"وَالضُّحَىٰ"},{"v":"93:2","t":"وَاللَّيْلِ إِذَا سَجَىٰ"},{"v":"93:3","t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"v":"93:4","t":"وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ"},{"v":"93:5","t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ"},{"v":"93:6","t":"أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ"},{"v":"93:7","t":"وَوَجَدَكَ ضَالًّا فَهَدَىٰ"},{"v":"93:8","t":"وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ"},{"v":"93:9","t":"فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ"},{"v":"93:10","t":"وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ"},{"v":"93:11","t":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"},{"v":"94:1","t":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"v":"94:2","t":"وَوَضَعْنَا عَنكَ وِزْرَكَ"},{"v":"94:3","t":"الَّذِي أَنقَضَ ظَهْرَكَ"},{"v":"94:4","t":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"v":"94:5","t":"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا"},{"v":"94:6","t":"إِنَّ مَعَ الْعُسْرِ يُسْرًا"},{"v":"94:7","t":"فَإِذَا فَرَغْتَ فَانصَبْ"},{"v":"94:8","t":"وَإِلَىٰ رَبِّكَ فَارْغَب"}]