[{"v":"109:1","t":"قُلْ يَا أَيُّهَا الْكَافِرُونَ"},{"v":"109:2","t":"لَا أَعْبُدُ مَا تَعْبُدُونَ"},{"v":"109:3","t":"وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ"},{"v":"109:4","t":"وَلَا أَنَا عَابِدٌ مَّا عَبَدتُّمْ"},{"v":"109:5","t":"وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ"},{"v":"109:6","t":"لَكُمْ دِينُكُمْ وَلِيَ دِينِ"},{"v":"110:1","t":"إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ"},{"v":"110:2","t":"وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا"},{"v":"110:3","t":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ ۚ إِنَّهُ كَانَ تَوَّابًا"},{"v":"111:1","t":"تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ"},{"v":"111:2","t":"مَا أَغْنَىٰ عَنْهُ مَالُهُ وَمَا كَسَبَ"},{"v":"111:3","t":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"},{"v":"111:4","t":"وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ"},{"v":"111:5","t":"فِي جِيدِهَا حَبْلٌ مِّن مَّسَدٍ"}]