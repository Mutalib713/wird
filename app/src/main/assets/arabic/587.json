[{"v":"82:1","t":"إِذَا السَّمَاءُ انفَطَرَتْ"},{"v":"82:2","t":"وَإِذَا الْكَوَاكِبُ انتَثَرَتْ"},{"v":"82:3","t":"وَإِذَا الْبِحَارُ فُجِّرَتْ"},{"v":"82:4","t":"وَإِذَا الْقُبُورُ بُعْثِرَتْ"},{"v":"82:5","t":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"},{"v":"82:6","t":"يَا أَيُّهَا الْإِنسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ"},{"v":"82:7","t":"الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ"},{"v":"82:8","t":"فِي أَيِّ صُورَةٍ مَّا شَاءَ رَكَّبَكَ"},{"v":"82:9","t":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ"},{"v":"82:10","t":"وَإِنَّ عَلَيْكُمْ لَحَافِظِينَ"},{"v":"82:11","t":"كِرَامًا كَاتِبِينَ"},{"v":"82:12","t":"يَعْلَمُونَ مَا تَفْعَلُونَ"},{"v":"82:13","t":"إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ"},{"v":"82:14","t":"وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ"},{"v":"82:15","t":"يَصْلَوْنَهَا يَوْمَ الدِّينِ"},{"v":"82:16","t":"وَمَا هُمْ عَنْهَا بِغَائِبِينَ"},{"v":"82:17","t":"وَمَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"},{"v":"82:18","t":"ثُمَّ مَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"},{"v":"82:19","t":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْئًا ۖ وَالْأَمْرُ يَوْمَئِذٍ لِّلَّهِ"},{"v":"83:1","t":"وَيْلٌ لِّلْمُطَفِّفِينَ"},{"v":"83:2","t":"الَّذِينَ إِذَا اكْتَالُوا عَلَى النَّاسِ يَسْتَوْفُونَ"},{"v":"83:3","t":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ"},{"v":"83:4","t":"أَلَا يَظُنُّ أُولَٰئِكَ أَنَّهُم مَّبْعُوثُونَ"},{"v":"83:5","t":"لِيَوْمٍ عَظِيمٍ"},{"v":"83:6","t":"يَوْمَ يَقُومُ النَّاسُ لِرَبِّ الْعَالَمِينَ"}]