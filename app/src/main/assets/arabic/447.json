[{"v":"37:25","t":"مَا لَكُمْ لَا تَنَاصَرُونَ"},{"v":"37:26","t":"بَلْ هُمُ الْيَوْمَ مُسْتَسْلِمُونَ"},{"v":"37:27","t":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ"},{"v":"37:28","t":"قَالُوا إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ الْيَمِينِ"},{"v":"37:29","t":"قَالُوا بَل لَّمْ تَكُونُوا مُؤْمِنِينَ"},{"v":"37:30","t":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَانٍ ۖ بَلْ كُنتُمْ قَوْمًا طَاغِينَ"},{"v":"37:31","t":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا ۖ إِنَّا لَذَائِقُونَ"},{"v":"37:32","t":"فَأَغْوَيْنَاكُمْ إِنَّا كُنَّا غَاوِينَ"},{"v":"37:33","t":"فَإِنَّهُمْ يَوْمَئِذٍ فِي الْعَذَابِ مُشْتَرِكُونَ"},{"v":"37:34","t":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَ"},{"v":"37:35","t":"إِنَّهُمْ كَانُوا إِذَا قِيلَ لَهُمْ لَا إِلَٰهَ إِلَّا اللَّهُ يَسْتَكْبِرُونَ"},{"v":"37:36","t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُو آلِهَتِنَا لِشَاعِرٍ مَّجْنُونٍ"},{"v":"37:37","t":"بَلْ جَاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِينَ"},{"v":"37:38","t":"إِنَّكُمْ لَذَائِقُو الْعَذَابِ الْأَلِيمِ"},{"v":"37:39","t":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},{"v":"37:40","t":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"v":"37:41","t":"أُولَٰئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"},{"v":"37:42","t":"فَوَاكِهُ ۖ وَهُم مُّكْرَمُونَ"},{"v":"37:43","t":"فِي جَنَّاتِ النَّعِيمِ"},{"v":"37:44","t":"عَلَىٰ سُرُرٍ مُّتَقَابِلِينَ"},{"v":"37:45","t":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍ"},{"v":"37:46","t":"بَيْضَاءَ لَذَّةٍ لِّلشَّارِبِينَ"},{"v":"37:47","t":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"},{"v":"37:48","t":"وَعِندَهُمْ قَاصِرَاتُ الطَّرْفِ عِينٌ"},{"v":"37:49","t":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"},{"v":"37:50","t":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ"},{"v":"37:51","t":"قَالَ قَائِلٌ مِّنْهُمْ إِنِّي كَانَ لِي قَرِينٌ"}]