[{"v":"86:1","t":"وَالسَّمَاءِ وَالطَّارِقِ"},{"v":"86:2","t":"وَمَا أَدْرَاكَ مَا الطَّارِقُ"},{"v":"86:3","t":"النَّجْمُ الثَّاقِبُ"},{"v":"86:4","t":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"v":"86:5","t":"فَلْيَنظُرِ الْإِنسَانُ مِمَّ خُلِقَ"},{"v":"86:6","t":"خُلِقَ مِن مَّاءٍ دَافِقٍ"},{"v":"86:7","t":"يَخْرُجُ مِن بَيْنِ الصُّلْبِ وَالتَّرَائِبِ"},{"v":"86:8","t":"إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ"},{"v":"86:9","t":"يَوْمَ تُبْلَى السَّرَائِرُ"},{"v":"86:10","t":"فَمَا لَهُ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"v":"86:11","t":"وَالسَّمَاءِ ذَاتِ الرَّجْعِ"},{"v":"86:12","t":"وَالْأَرْضِ ذَاتِ الصَّدْعِ"},{"v":"86:13","t":"إِنَّهُ لَقَوْلٌ فَصْلٌ"},{"v":"86:14","t":"وَمَا هُوَ بِالْهَزْلِ"},{"v":"86:15","t":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"v":"86:16","t":"وَأَكِيدُ كَيْدًا"},{"v":"86:17","t":"فَمَهِّلِ الْكَافِرِينَ أَمْهِلْهُمْ رُوَيْدًا"},{"v":"87:1","t":"سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى"},{"v":"87:2","t":"الَّذِي خَلَقَ فَسَوَّىٰ"},{"v":"87:3","t":"وَالَّذِي قَدَّرَ فَهَدَىٰ"},{"v":"87:4","t":"وَالَّذِي أَخْرَجَ الْمَرْعَىٰ"},{"v":"87:5","t":"فَجَعَلَهُ غُثَاءً أَحْوَىٰ"},{"v":"87:6","t":"سَنُقْرِئُكَ فَلَا تَنسَىٰ"},{"v":"87:7","t":"إِلَّا مَا شَاءَ اللَّهُ ۚ إِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفَىٰ"},{"v":"87:8","t":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"v":"87:9","t":"فَذَكِّرْ إِن نَّفَعَتِ الذِّكْرَىٰ"},{"v":"87:10","t":"سَيَذَّكَّرُ مَن يَخْشَىٰ"},{"v":"87:11","t":"وَيَتَجَنَّبُهَا الْأَشْقَى"},{"v":"87:12","t":"الَّذِي يَصْلَى النَّارَ الْكُبْرَىٰ"},{"v":"87:13","t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"v":"87:14","t":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"v":"87:15","t":"وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّىٰ"}]