[{"v":"1:1","t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"},{"v":"1:2","t":"الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"},{"v":"1:3","t":"الرَّحْمَٰنِ الرَّحِيمِ"},{"v":"1:4","t":"مَالِكِ يَوْمِ الدِّينِ"},{"v":"1:5","t":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"},{"v":"1:6","t":"اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"},{"v":"1:7","t":"صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"}]