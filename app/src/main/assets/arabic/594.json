[{"v":"89:24","t":"يَقُولُ يَا لَيْتَنِي قَدَّمْتُ لِحَيَاتِي"},{"v":"89:25","t":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُ أَحَدٌ"},{"v":"89:26","t":"وَلَا يُوثِقُ وَثَاقَهُ أَحَدٌ"},{"v":"89:27","t":"يَا أَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُ"},{"v":"89:28","t":"ارْجِعِي إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},{"v":"89:29","t":"فَادْخُلِي فِي عِبَادِي"},{"v":"89:30","t":"وَادْخُلِي جَنَّتِي"},{"v":"90:1","t":"لَا أُقْسِمُ بِهَٰذَا الْبَلَدِ"},{"v":"90:2","t":"وَأَنتَ حِلٌّ بِهَٰذَا الْبَلَدِ"},{"v":"90:3","t":"وَوَالِدٍ وَمَا وَلَدَ"},{"v":"90:4","t":"لَقَدْ خَلَقْنَا الْإِنسَانَ فِي كَبَدٍ"},{"v":"90:5","t":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"},{"v":"90:6","t":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"},{"v":"90:7","t":"أَيَحْسَبُ أَن لَّمْ يَرَهُ أَحَدٌ"},{"v":"90:8","t":"أَلَمْ نَجْعَل لَّهُ عَيْنَيْنِ"},{"v":"90:9","t":"وَلِسَانًا وَشَفَتَيْنِ"},{"v":"90:10","t":"وَهَدَيْنَاهُ النَّجْدَيْنِ"},{"v":"90:11","t":"فَلَا اقْتَحَمَ الْعَقَبَةَ"},{"v":"90:12","t":"وَمَا أَدْرَاكَ مَا الْعَقَبَةُ"},{"v":"90:13","t":"فَكُّ رَقَبَةٍ"},{"v":"90:14","t":"أَوْ إِطْعَامٌ فِي يَوْمٍ ذِي مَسْغَبَةٍ"},{"v":"90:15","t":"يَتِيمًا ذَا مَقْرَبَةٍ"},{"v":"90:16","t":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"},{"v":"90:17","t":"ثُمَّ كَانَ مِنَ الَّذِينَ آمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ"},{"v":"90:18","t":"أُولَٰئِكَ أَصْحَابُ الْمَيْمَنَةِ"},{"v":"90:19","t":"وَالَّذِينَ كَفَرُوا بِآيَاتِنَا هُمْ أَصْحَابُ الْمَشْأَمَةِ"},{"v":"90:20","t":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌ"}]