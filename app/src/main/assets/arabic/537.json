[{"v":"56:77","t":"إِنَّهُ لَقُرْآنٌ كَرِيمٌ"},{"v":"56:78","t":"فِي كِتَابٍ مَّكْنُونٍ"},{"v":"56:79","t":"لَّا يَمَسُّهُ إِلَّا الْمُطَهَّرُونَ"},{"v":"56:80","t":"تَنزِيلٌ مِّن رَّبِّ الْعَالَمِينَ"},{"v":"56:81","t":"أَفَبِهَٰذَا الْحَدِيثِ أَنتُم مُّدْهِنُونَ"},{"v":"56:82","t":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"},{"v":"56:83","t":"فَلَوْلَا إِذَا بَلَغَتِ الْحُلْقُومَ"},{"v":"56:84","t":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ"},{"v":"56:85","t":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ"},{"v":"56:86","t":"فَلَوْلَا إِن كُنتُمْ غَيْرَ مَدِينِينَ"},{"v":"56:87","t":"تَرْجِعُونَهَا إِن كُنتُمْ صَادِقِينَ"},{"v":"56:88","t":"فَأَمَّا إِن كَانَ مِنَ الْمُقَرَّبِينَ"},{"v":"56:89","t":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ"},{"v":"56:90","t":"وَأَمَّا إِن كَانَ مِنْ أَصْحَابِ الْيَمِينِ"},{"v":"56:91","t":"فَسَلَامٌ لَّكَ مِنْ أَصْحَابِ الْيَمِينِ"},{"v":"56:92","t":"وَأَمَّا إِن كَانَ مِنَ الْمُكَذِّبِينَ الضَّالِّينَ"},{"v":"56:93","t":"فَنُزُلٌ مِّنْ حَمِيمٍ"},{"v":"56:94","t":"وَتَصْلِيَةُ جَحِيمٍ"},{"v":"56:95","t":"إِنَّ هَٰذَا لَهُوَ حَقُّ الْيَقِينِ"},{"v":"56:96","t":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ"},{"v":"57:1","t":"سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ ۖ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},{"v":"57:2","t":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۖ يُحْيِي وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ"},{"v":"57:3","t":"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ"}]