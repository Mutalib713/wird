[{"v":"91:1","t":"وَالشَّمْسِ وَضُحَاهَا"},{"v":"91:2","t":"وَالْقَمَرِ إِذَا تَلَاهَا"},{"v":"91:3","t":"وَالنَّهَارِ إِذَا جَلَّاهَا"},{"v":"91:4","t":"وَاللَّيْلِ إِذَا يَغْشَاهَا"},{"v":"91:5","t":"وَالسَّمَاءِ وَمَا بَنَاهَا"},{"v":"91:6","t":"وَالْأَرْضِ وَمَا طَحَاهَا"},{"v":"91:7","t":"وَنَفْسٍ وَمَا سَوَّاهَا"},{"v":"91:8","t":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا"},{"v":"91:9","t":"قَدْ أَفْلَحَ مَن زَكَّاهَا"},{"v":"91:10","t":"وَقَدْ خَابَ مَن دَسَّاهَا"},{"v":"91:11","t":"كَذَّبَتْ ثَمُودُ بِطَغْوَاهَا"},{"v":"91:12","t":"إِذِ انبَعَثَ أَشْقَاهَا"},{"v":"91:13","t":"فَقَالَ لَهُمْ رَسُولُ اللَّهِ نَاقَةَ اللَّهِ وَسُقْيَاهَا"},{"v":"91:14","t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنبِهِمْ فَسَوَّاهَا"},{"v":"91:15","t":"وَلَا يَخَافُ عُقْبَاهَا"},{"v":"92:1","t":"وَاللَّيْلِ إِذَا يَغْشَىٰ"},{"v":"92:2","t":"وَالنَّهَارِ إِذَا تَجَلَّىٰ"},{"v":"92:3","t":"وَمَا خَلَقَ الذَّكَرَ وَالْأُنثَىٰ"},{"v":"92:4","t":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"},{"v":"92:5","t":"فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ"},{"v":"92:6","t":"وَصَدَّقَ بِالْحُسْنَىٰ"},{"v":"92:7","t":"فَسَنُيَسِّرُهُ لِلْيُسْرَىٰ"},{"v":"92:8","t":"وَأَمَّا مَن بَخِلَ وَاسْتَغْنَىٰ"},{"v":"92:9","t":"وَكَذَّبَ بِالْحُسْنَىٰ"},{"v":"92:10","t":"فَسَنُيَسِّرُهُ لِلْعُسْرَىٰ"},{"v":"92:11","t":"وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّىٰ"},{"v":"92:12","t":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"},{"v":"92:13","t":"وَإِنَّ لَنَا لَلْآخِرَةَ وَالْأُولَىٰ"},{"v":"92:14","t":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"}]