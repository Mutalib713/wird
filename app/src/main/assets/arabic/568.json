[{"v":"69:35","t":"فَلَيْسَ لَهُ الْيَوْمَ هَاهُنَا حَمِيمٌ"},{"v":"69:36","t":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ"},{"v":"69:37","t":"لَّا يَأْكُلُهُ إِلَّا الْخَاطِئُونَ"},{"v":"69:38","t":"فَلَا أُقْسِمُ بِمَا تُبْصِرُونَ"},{"v":"69:39","t":"وَمَا لَا تُبْصِرُونَ"},{"v":"69:40","t":"إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"v":"69:41","t":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ"},{"v":"69:42","t":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ"},{"v":"69:43","t":"تَنزِيلٌ مِّن رَّبِّ الْعَالَمِينَ"},{"v":"69:44","t":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْأَقَاوِيلِ"},{"v":"69:45","t":"لَأَخَذْنَا مِنْهُ بِالْيَمِينِ"},{"v":"69:46","t":"ثُمَّ لَقَطَعْنَا مِنْهُ الْوَتِينَ"},{"v":"69:47","t":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَاجِزِينَ"},{"v":"69:48","t":"وَإِنَّهُ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ"},{"v":"69:49","t":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ"},{"v":"69:50","t":"وَإِنَّهُ لَحَسْرَةٌ عَلَى الْكَافِرِينَ"},{"v":"69:51","t":"وَإِنَّهُ لَحَقُّ الْيَقِينِ"},{"v":"69:52","t":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ"},{"v":"70:1","t":"سَأَلَ سَائِلٌ بِعَذَابٍ وَاقِعٍ"},{"v":"70:2","t":"لِّلْكَافِرِينَ لَيْسَ لَهُ دَافِعٌ"},{"v":"70:3","t":"مِّنَ اللَّهِ ذِي الْمَعَارِجِ"},{"v":"70:4","t":"تَعْرُجُ الْمَلَائِكَةُ وَالرُّوحُ إِلَيْهِ فِي يَوْمٍ كَانَ مِقْدَارُهُ خَمْسِينَ أَلْفَ سَنَةٍ"},{"v":"70:5","t":"فَاصْبِرْ صَبْرًا جَمِيلًا"},{"v":"70:6","t":"إِنَّهُمْ يَرَوْنَهُ بَعِيدًا"},{"v":"70:7","t":"وَنَرَاهُ قَرِيبًا"},{"v":"70:8","t":"يَوْمَ تَكُونُ السَّمَاءُ كَالْمُهْلِ"},{"v":"70:9","t":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ"},{"v":"70:10","t":"وَلَا يَسْأَلُ حَمِيمٌ حَمِيمًا"}]