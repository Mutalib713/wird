[{"v":"56:51","t":"ثُمَّ إِنَّكُمْ أَيُّهَا الضَّالُّونَ الْمُكَذِّبُونَ"},{"v":"56:52","t":"لَآكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ"},{"v":"56:53","t":"فَمَالِئُونَ مِنْهَا الْبُطُونَ"},{"v":"56:54","t":"فَشَارِبُونَ عَلَيْهِ مِنَ الْحَمِيمِ"},{"v":"56:55","t":"فَشَارِبُونَ شُرْبَ الْهِيمِ"},{"v":"56:56","t":"هَٰذَا نُزُلُهُمْ يَوْمَ الدِّينِ"},{"v":"56:57","t":"نَحْنُ خَلَقْنَاكُمْ فَلَوْلَا تُصَدِّقُونَ"},{"v":"56:58","t":"أَفَرَأَيْتُم مَّا تُمْنُونَ"},{"v":"56:59","t":"أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ"},{"v":"56:60","t":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"v":"56:61","t":"عَلَىٰ أَن نُّبَدِّلَ أَمْثَالَكُمْ وَنُنشِئَكُمْ فِي مَا لَا تَعْلَمُونَ"},{"v":"56:62","t":"وَلَقَدْ عَلِمْتُمُ النَّشْأَةَ الْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"},{"v":"56:63","t":"أَفَرَأَيْتُم مَّا تَحْرُثُونَ"},{"v":"56:64","t":"أَأَنتُمْ تَزْرَعُونَهُ أَمْ نَحْنُ الزَّارِعُونَ"},{"v":"56:65","t":"لَوْ نَشَاءُ لَجَعَلْنَاهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُونَ"},{"v":"56:66","t":"إِنَّا لَمُغْرَمُونَ"},{"v":"56:67","t":"بَلْ نَحْنُ مَحْرُومُونَ"},{"v":"56:68","t":"أَفَرَأَيْتُمُ الْمَاءَ الَّذِي تَشْرَبُونَ"},{"v":"56:69","t":"أَأَنتُمْ أَنزَلْتُمُوهُ مِنَ الْمُزْنِ أَمْ نَحْنُ الْمُنزِلُونَ"},{"v":"56:70","t":"لَوْ نَشَاءُ جَعَلْنَاهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ"},{"v":"56:71","t":"أَفَرَأَيْتُمُ النَّارَ الَّتِي تُورُونَ"},{"v":"56:72","t":"أَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَا أَمْ نَحْنُ الْمُنشِئُونَ"},{"v":"56:73","t":"نَحْنُ جَعَلْنَاهَا تَذْكِرَةً وَمَتَاعًا لِّلْمُقْوِينَ"},{"v":"56:74","t":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ"},{"v":"56:75","t":"فَلَا أُقْسِمُ بِمَوَاقِعِ النُّجُومِ"},{"v":"56:76","t":"وَإِنَّهُ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ"}]