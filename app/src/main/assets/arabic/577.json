[{"v":"74:48","t":"فَمَا تَنفَعُهُمْ شَفَاعَةُ الشَّافِعِينَ"},{"v":"74:49","t":"فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضِينَ"},{"v":"74:50","t":"كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ"},{"v":"74:51","t":"فَرَّتْ مِن قَسْوَرَةٍ"},{"v":"74:52","t":"بَلْ يُرِيدُ كُلُّ امْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً"},{"v":"74:53","t":"كَلَّا ۖ بَل لَّا يَخَافُونَ الْآخِرَةَ"},{"v":"74:54","t":"كَلَّا إِنَّهُ تَذْكِرَةٌ"},{"v":"74:55","t":"فَمَن شَاءَ ذَكَرَهُ"},{"v":"74:56","t":"وَمَا يَذْكُرُونَ إِلَّا أَن يَشَاءَ اللَّهُ ۚ هُوَ أَهْلُ التَّقْوَىٰ وَأَهْلُ الْمَغْفِرَةِ"},{"v":"75:1","t":"لَا أُقْسِمُ بِيَوْمِ الْقِيَامَةِ"},{"v":"75:2","t":"وَلَا أُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ"},{"v":"75:3","t":"أَيَحْسَبُ الْإِنسَانُ أَلَّن نَّجْمَعَ عِظَامَهُ"},{"v":"75:4","t":"بَلَىٰ قَادِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُ"},{"v":"75:5","t":"بَلْ يُرِيدُ الْإِنسَانُ لِيَفْجُرَ أَمَامَهُ"},{"v":"75:6","t":"يَسْأَلُ أَيَّانَ يَوْمُ الْقِيَامَةِ"},{"v":"75:7","t":"فَإِذَا بَرِقَ الْبَصَرُ"},{"v":"75:8","t":"وَخَسَفَ الْقَمَرُ"},{"v":"75:9","t":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُ"},{"v":"75:10","t":"يَقُولُ الْإِنسَانُ يَوْمَئِذٍ أَيْنَ الْمَفَرُّ"},{"v":"75:11","t":"كَلَّا لَا وَزَرَ"},{"v":"75:12","t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ الْمُسْتَقَرُّ"},{"v":"75:13","t":"يُنَبَّأُ الْإِنسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ"},{"v":"75:14","t":"بَلِ الْإِنسَانُ عَلَىٰ نَفْسِهِ بَصِيرَةٌ"},{"v":"75:15","t":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُ"},{"v":"75:16","t":"لَا تُحَرِّكْ بِهِ لِسَانَكَ لِتَعْجَلَ بِهِ"},{"v":"75:17","t":"إِنَّ عَلَيْنَا جَمْعَهُ وَقُرْآنَهُ"},{"v":"75:18","t":"فَإِذَا قَرَأْنَاهُ فَاتَّبِعْ قُرْآنَهُ"},{"v":"75:19","t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُ"}]