[{"v":"37:103","t":"فَلَمَّا أَسْلَمَا وَتَلَّهُ لِلْجَبِينِ"},{"v":"37:104","t":"وَنَادَيْنَاهُ أَن يَا إِبْرَاهِيمُ"},{"v":"37:105","t":"قَدْ صَدَّقْتَ الرُّؤْيَا ۚ إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ"},{"v":"37:106","t":"إِنَّ هَٰذَا لَهُوَ الْبَلَاءُ الْمُبِينُ"},{"v":"37:107","t":"وَفَدَيْنَاهُ بِذِبْحٍ عَظِيمٍ"},{"v":"37:108","t":"وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ"},{"v":"37:109","t":"سَلَامٌ عَلَىٰ إِبْرَاهِيمَ"},{"v":"37:110","t":"كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ"},{"v":"37:111","t":"إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ"},{"v":"37:112","t":"وَبَشَّرْنَاهُ بِإِسْحَاقَ نَبِيًّا مِّنَ الصَّالِحِينَ"},{"v":"37:113","t":"وَبَارَكْنَا عَلَيْهِ وَعَلَىٰ إِسْحَاقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِ مُبِينٌ"},{"v":"37:114","t":"وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَارُونَ"},{"v":"37:115","t":"وَنَجَّيْنَاهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظِيمِ"},{"v":"37:116","t":"وَنَصَرْنَاهُمْ فَكَانُوا هُمُ الْغَالِبِينَ"},{"v":"37:117","t":"وَآتَيْنَاهُمَا الْكِتَابَ الْمُسْتَبِينَ"},{"v":"37:118","t":"وَهَدَيْنَاهُمَا الصِّرَاطَ الْمُسْتَقِيمَ"},{"v":"37:119","t":"وَتَرَكْنَا عَلَيْهِمَا فِي الْآخِرِينَ"},{"v":"37:120","t":"سَلَامٌ عَلَىٰ مُوسَىٰ وَهَارُونَ"},{"v":"37:121","t":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ"},{"v":"37:122","t":"إِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِنِينَ"},{"v":"37:123","t":"وَإِنَّ إِلْيَاسَ لَمِنَ الْمُرْسَلِينَ"},{"v":"37:124","t":"إِذْ قَالَ لِقَوْمِهِ أَلَا تَتَّقُونَ"},{"v":"37:125","t":"أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ الْخَالِقِينَ"},{"v":"37:126","t":"اللَّهَ رَبَّكُمْ وَرَبَّ آبَائِكُمُ الْأَوَّلِينَ"}]