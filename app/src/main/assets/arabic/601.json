[{"v":"103:1","t":"وَالْعَصْرِ"},{"v":"103:2","t":"إِنَّ الْإِنسَانَ لَفِي خُسْرٍ"},{"v":"103:3","t":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ"},{"v":"104:1","t":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"},{"v":"104:2","t":"الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ"},{"v":"104:3","t":"يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ"},{"v":"104:4","t":"كَلَّا ۖ لَيُنبَذَنَّ فِي الْحُطَمَةِ"},{"v":"104:5","t":"وَمَا أَدْرَاكَ مَا الْحُطَمَةُ"},{"v":"104:6","t":"نَارُ اللَّهِ الْمُوقَدَةُ"},{"v":"104:7","t":"الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ"},{"v":"104:8","t":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"},{"v":"104:9","t":"فِي عَمَدٍ مُّمَدَّدَةٍ"},{"v":"105:1","t":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ"},{"v":"105:2","t":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ"},{"v":"105:3","t":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"},{"v":"105:4","t":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"},{"v":"105:5","t":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍ"}]