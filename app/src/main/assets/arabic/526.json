[{"v":"53:1","t":"وَالنَّجْمِ إِذَا هَوَىٰ"},{"v":"53:2","t":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ"},{"v":"53:3","t":"وَمَا يَنطِقُ عَنِ الْهَوَىٰ"},{"v":"53:4","t":"إِنْ هُوَ إِلَّا وَحْيٌ يُوحَىٰ"},{"v":"53:5","t":"عَلَّمَهُ شَدِيدُ الْقُوَىٰ"},{"v":"53:6","t":"ذُو مِرَّةٍ فَاسْتَوَىٰ"},{"v":"53:7","t":"وَهُوَ بِالْأُفُقِ الْأَعْلَىٰ"},{"v":"53:8","t":"ثُمَّ دَنَا فَتَدَلَّىٰ"},{"v":"53:9","t":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ"},{"v":"53:10","t":"فَأَوْحَىٰ إِلَىٰ عَبْدِهِ مَا أَوْحَىٰ"},{"v":"53:11","t":"مَا كَذَبَ الْفُؤَادُ مَا رَأَىٰ"},{"v":"53:12","t":"أَفَتُمَارُونَهُ عَلَىٰ مَا يَرَىٰ"},{"v":"53:13","t":"وَلَقَدْ رَآهُ نَزْلَةً أُخْرَىٰ"},{"v":"53:14","t":"عِندَ سِدْرَةِ الْمُنتَهَىٰ"},{"v":"53:15","t":"عِندَهَا جَنَّةُ الْمَأْوَىٰ"},{"v":"53:16","t":"إِذْ يَغْشَى السِّدْرَةَ مَا يَغْشَىٰ"},{"v":"53:17","t":"مَا زَاغَ الْبَصَرُ وَمَا طَغَىٰ"},{"v":"53:18","t":"لَقَدْ رَأَىٰ مِنْ آيَاتِ رَبِّهِ الْكُبْرَىٰ"},{"v":"53:19","t":"أَفَرَأَيْتُمُ اللَّاتَ وَالْعُزَّىٰ"},{"v":"53:20","t":"وَمَنَاةَ الثَّالِثَةَ الْأُخْرَىٰ"},{"v":"53:21","t":"أَلَكُمُ الذَّكَرُ وَلَهُ الْأُنثَىٰ"},{"v":"53:22","t":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰ"},{"v":"53:23","t":"إِنْ هِيَ إِلَّا أَسْمَاءٌ سَمَّيْتُمُوهَا أَنتُمْ وَآبَاؤُكُم مَّا أَنزَلَ اللَّهُ بِهَا مِن سُلْطَانٍ ۚ إِن يَتَّبِعُونَ إِلَّا الظَّنَّ وَمَا تَهْوَى الْأَنفُسُ ۖ وَلَقَدْ جَاءَهُم مِّن رَّبِّهِمُ الْهُدَىٰ"},{"v":"53:24","t":"أَمْ لِلْإِنسَانِ مَا تَمَنَّىٰ"},{"v":"53:25","t":"فَلِلَّهِ الْآخِرَةُ وَالْأُولَىٰ"},{"v":"53:26","t":"وَكَم مِّن مَّلَكٍ فِي السَّمَاوَاتِ لَا تُغْنِي شَفَاعَتُهُمْ شَيْئًا إِلَّا مِن بَعْدِ أَن يَأْذَنَ اللَّهُ لِمَن يَشَاءُ وَيَرْضَىٰ"}]