[{"v":"79:16","t":"إِذْ نَادَاهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًى"},{"v":"79:17","t":"اذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُ طَغَىٰ"},{"v":"79:18","t":"فَقُلْ هَل لَّكَ إِلَىٰ أَن تَزَكَّىٰ"},{"v":"79:19","t":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"},{"v":"79:20","t":"فَأَرَاهُ الْآيَةَ الْكُبْرَىٰ"},{"v":"79:21","t":"فَكَذَّبَ وَعَصَىٰ"},{"v":"79:22","t":"ثُمَّ أَدْبَرَ يَسْعَىٰ"},{"v":"79:23","t":"فَحَشَرَ فَنَادَىٰ"},{"v":"79:24","t":"فَقَالَ أَنَا رَبُّكُمُ الْأَعْلَىٰ"},{"v":"79:25","t":"فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَىٰ"},{"v":"79:26","t":"إِنَّ فِي ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰ"},{"v":"79:27","t":"أَأَنتُمْ أَشَدُّ خَلْقًا أَمِ السَّمَاءُ ۚ بَنَاهَا"},{"v":"79:28","t":"رَفَعَ سَمْكَهَا فَسَوَّاهَا"},{"v":"79:29","t":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَاهَا"},{"v":"79:30","t":"وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَاهَا"},{"v":"79:31","t":"أَخْرَجَ مِنْهَا مَاءَهَا وَمَرْعَاهَا"},{"v":"79:32","t":"وَالْجِبَالَ أَرْسَاهَا"},{"v":"79:33","t":"مَتَاعًا لَّكُمْ وَلِأَنْعَامِكُمْ"},{"v":"79:34","t":"فَإِذَا جَاءَتِ الطَّامَّةُ الْكُبْرَىٰ"},{"v":"79:35","t":"يَوْمَ يَتَذَكَّرُ الْإِنسَانُ مَا سَعَىٰ"},{"v":"79:36","t":"وَبُرِّزَتِ الْجَحِيمُ لِمَن يَرَىٰ"},{"v":"79:37","t":"فَأَمَّا مَن طَغَىٰ"},{"v":"79:38","t":"وَآثَرَ الْحَيَاةَ الدُّنْيَا"},{"v":"79:39","t":"فَإِنَّ الْجَحِيمَ هِيَ الْمَأْوَىٰ"},{"v":"79:40","t":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِ وَنَهَى النَّفْسَ عَنِ الْهَوَىٰ"},{"v":"79:41","t":"فَإِنَّ الْجَنَّةَ هِيَ الْمَأْوَىٰ"},{"v":"79:42","t":"يَسْأَلُونَكَ عَنِ السَّاعَةِ أَيَّانَ مُرْسَاهَا"},{"v":"79:43","t":"فِيمَ أَنتَ مِن ذِكْرَاهَا"},{"v":"79:44","t":"إِلَىٰ رَبِّكَ مُنتَهَاهَا"},{"v":"79:45","t":"إِنَّمَا أَنتَ مُنذِرُ مَن يَخْشَاهَا"},{"v":"79:46","t":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوا إِلَّا عَشِيَّةً أَوْ ضُحَاهَا"}]