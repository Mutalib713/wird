<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Fetching mushaf pages and their glyph fonts, once each, then cached on disk
      forever. Nothing is ever uploaded — see Sacred Rule 1.
    -->

    <!--
      PLAN task 12. On API 30 and up an app cannot see another package unless it says so
      here; without this, "is Quran for Android installed?" answers no on every phone.

      Scoped to the one scheme rather than QUERY_ALL_PACKAGES, which is a Play-policy
      flashpoint and would let Wird enumerate everything installed. It has no business
      knowing that.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="quran" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Reciting out loud. The recording is written to app-private storage and never
      uploaded, never backed up, and never shared unless the reader chooses to (task 11).
      Sacred Rule 1.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 13+ asks the user before any notification can appear. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Coarse location, for one job: working out when Maghrib is, so the reminder follows
      the sun instead of a fixed clock hour. Mutalib chose this on 2026-08-16 over
      deriving a city from the timezone, because Accra and Kumasi are seven minutes apart
      at sunset and he moves between them.

      COARSE, never FINE — sunset does not care about the difference, and the coordinates
      are rounded to two decimals (~1 km) before they are stored. Asked for once, then
      remembered; the app does not reach for your whereabouts every morning. Nothing is
      uploaded. Sacred Rule 1.

      Refusing it is a supported answer: the app falls back to the phone's timezone, and
      then to a fixed evening hour, and says on the settings screen which one it is using.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Exact alarms. Declaring this is not the same as having it: from Android 14 the
      permission is denied by default for anything that is not a clock or a calendar,
      and the user must grant it in system settings. Wird degrades to an inexact alarm
      when it is refused rather than pretending it worked.

      Note we deliberately do NOT declare USE_EXACT_ALARM, which is granted
      automatically — Google Play restricts it to alarm clock and calendar apps, and
      claiming it for a reading reminder would be a launch problem later.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Alarms are wiped by a reboot; this lets us set them again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Three overlapping statements of the same rule, because they apply to different
      Android versions: fullBackupContent for 11 and below, dataExtractionRules for 12
      and above, allowBackup=false over the top of both. Nothing leaves this phone.
      See Sacred Rule 1 and res/xml/.
    -->
    <!-- The whole-mushaf download runs as a foreground service: Android trades survival
         for visibility, and a 45-minute download has to be visible anyway. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wird">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ours only. Nothing outside the app should be able to fire the nudge. -->
        <receiver
            android:name=".nudge.NudgeReceiver"
            android:exported="false" />

        <!-- Exported because the boot broadcast comes from the system. -->
        <receiver
            android:name=".nudge.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <!--
            The home-screen widget (PLAN task 10).

            exported="true" is required and is not a loosening: a widget is hosted by the
            launcher, which is a different app, so the launcher must be able to bind it.
            It receives only the two system broadcasts declared below and acts on neither
            of them with any data from outside.
        -->
        <receiver
            android:name=".widget.WirdWidgetReceiver"
            android:exported="true"
            android:label="Today's portion">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wird_widget_info" />
        </receiver>


        <!--
            Hands the export zip to whatever app the reader picks from the share sheet.

            exported="false" with grantUriPermissions="true" is the safe pairing: nothing can
            query this provider, and the only thing another app ever receives is the single
            URI attached to a share the reader started themselves.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


        <!--
            Answering the nudge from the notification itself. PLAN task 21.

            exported="false": only this app's own notification ever sends it, and nothing
            outside should be able to book a commitment on the reader's behalf.
        -->
        <receiver
            android:name=".nudge.CommitReceiver"
            android:exported="false" />


        <service
            android:name=".mushaf.MushafDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
