<?xml version="1.0" encoding="utf-8"?>
<!--
  Sacred Rule 1: recordings never leave the device unless the user explicitly shares
  them. Cloud backup and device-to-device transfer would both move them off the phone
  without anyone deciding to, so both are excluded entirely — not just the audio, but
  everything, because a partial rule is a rule someone forgets to extend.

  The cost is real and accepted: a new phone starts empty. Task 19 (export) is the
  sanctioned way to move your own data, and it is a thing you choose rather than a
  thing that happens to you.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
