<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 11-and-below half of Sacred Rule 1. data_extraction_rules.xml covers
  Android 12+; this covers everything older, down to minSdk 26. Both exclude
  everything, and allowBackup="false" in the manifest is the belt to this pair of
  braces.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
