{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/images/(.*)", "dest": "/showcase/images/$1" },
    { "src": "/videos/(.*)", "dest": "/showcase/videos/$1" },
    { "src": "/downloads/(.*)", "dest": "/showcase/downloads/$1" },
    { "src": "/showcase/(.*)", "dest": "/showcase/$1" },
    { "src": "/showcase", "dest": "/showcase/index.html" },
    { "src": "/", "dest": "/showcase/index.html" }
  ]
}
