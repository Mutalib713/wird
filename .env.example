# Wird — copy to .env and fill. .env is gitignored.
# DRY_RUN=1 is the default for anything that sends or uploads.

DRY_RUN=1

# Firebase App Distribution (task 16). With DRY_RUN=1 the build is made locally and
# never uploaded.
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional, task 13 only — plain-words schedule parsing. Cut this task if it costs more
# than it earns; a dropdown does most of the job.
ANTHROPIC_API_KEY=

# No key is needed for any of these, and none should ever appear here:
#   api.quran.com          — Qur'an text and layout, public
#   everyayah.com          — al-Shatri audio, public
#   nuqayah/qpc-fonts      — QCF mushaf fonts, public
#   whisper-base-ar-quran  — Apache-2.0 model weights
