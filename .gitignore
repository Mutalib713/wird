*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
# No leading slash: this must match app/build too, not just a build/ at the repo root.
# The root-anchored form let ~1,500 build artifacts into the first task-1 commit.
build/
/captures
.externalNativeBuild
.cxx
local.properties

# Secrets — never commit
.env
.env.local
*.keystore
*.jks
google-services.json
firebase-service-account*.json

# Recordings are personal. They never leave the device, and they never enter the repo.
/recordings/
*.m4a
*.wav

# Cached mushaf assets — fetched on demand, not versioned
/app/src/main/assets/qcf/
/fonts-cache/
